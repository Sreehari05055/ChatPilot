# --- LLM CONFIGURATION ---
# Options: openai, anthropic, google, deepseek, ollama
LLM_PROVIDER=openai
# Examples: gpt-4o, claude-3-5-sonnet-20240620, gemini-2.5-flash, deepseek-chat
MODEL_NAME=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# --- SEARCH CONFIGURATION ---
# Tavily API Key (Highly Recommended for Web Research & News)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search (Optional Fallback)
WEB_SEARCH_API_KEY=your_google_custom_search_key
CSE_ID=your_google_cse_id
COHERE_API_KEY=your_cohere_api_key_here

# --- RAG / EMBEDDING CONFIGURATION ---
# Options: openai, cohere, baai
RERANKING_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- STORAGE CONFIGURATION ---
# Directory for chat history and uploaded files
STORAGE_DIR=conversations

# --- EXECUTION SETTINGS ---
# Max retries for the Data Analysis Agent (LangGraph)
EXEC_MAX_RETRIES=3

# Timeout for heavy web fetches/analysis tasks (seconds)
HTTP_TIMEOUT=30.0

# Number of web search results to retrieve
WEB_SEARCH_NUM_RESULTS=5


SANDBOX_NANO_CPUS=500000000 # 0.5 CPU
SANDBOX_MEM_LIMIT=2g # 2 GB. Maximum memory for the container
SANDBOX_MEM_RESERVATION=1g # 1 GB. Minimum memory to keep the container running  
SANDBOX_MEMSWAP_LIMIT=2g # 2 GB. Helpful to limit swap usage
SANDBOX_PIDS_LIMIT=64 # 64 processes. Helps limit the number of processes in the container  
SANDBOX_SHM_SIZE=64m # 64 MB. Size of /dev/shm (Shared Memory: useful for some code execution tasks) 
SANDBOX_AUTO_REMOVE=true # Automatically remove the container when it exits
