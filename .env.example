# --- SERVER CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- LLM CONFIGURATION ---
# Options: openai, anthropic, google, deepseek, ollama
LLM_PROVIDER=openai
# Examples: gpt-4o, claude-3-5-sonnet-20240620, gemini-2.5-flash, deepseek-chat
MODEL_NAME=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# --- SEARCH CONFIGURATION ---
# Tavily API Key (Highly Recommended for Web Research & News)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search (Optional Fallback)
WEB_SEARCH_API_KEY=your_google_custom_search_key
CSE_ID=your_google_cse_id

# --- STORAGE CONFIGURATION ---
# Directory for chat history and uploaded files
STORAGE_DIR=conversations

# --- EXECUTION SETTINGS ---
# Max retries for the Data Analysis Agent (LangGraph)
EXEC_MAX_RETRIES=3

# Timeout for heavy web fetches/analysis tasks (seconds)
HTTP_TIMEOUT=30.0

# Number of web search results to retrieve
WEB_SEARCH_NUM_RESULTS=5
